{
  "name": "ai-death",
  "version": "0.1.0",
  "private": true,
  "description": "Death, respawn at hospitals, EMS revive and treatment",
  "license": "GPL-3.0-only",
  "author": {
    "name": "ai-core"
  },
  "type": "module",
  "fxDependencies": [
    "/onesync",
    "ai-core"
  ],
  "scripts": {
    "lint": "oxlint --ignore-pattern \"dist/**\" --ignore-pattern \"web/postcss-*.js\"",
    "format": "oxfmt",
    "dev": "bun tsdown -- --watch",
    "build": "bun run --cwd web build && bun tsdown -- && aicore-client-errors dist/client.js",
    "typecheck": "tsc --noEmit -p resource/client/tsconfig.json && tsc --noEmit -p resource/server/tsconfig.json",
    "webdev": "bun --cwd web vite"
  },
  "dependencies": {
    "@aicore-fivem/lib": "^0.1.0",
    "@aicore-fivem/shared": "^0.1.0"
  },
  "devDependencies": {
    "@aicore-fivem/build": "^0.1.0",
    "@citizenfx/client": "latest",
    "@citizenfx/server": "latest",
    "@overextended/core": "^0.3.1",
    "@types/bun": "latest",
    "@types/node": "^22",
    "fast-glob": "^3.3.3",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "fxFiles": [
    "data/settings.json",
    "data/hospitals.json"
  ]
}
